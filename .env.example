# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# All values below are placeholders. `uv run blast-radius doctor` tells you
# which ones are actually required for the command you are trying to run.

# --- DataHub ----------------------------------------------------------------
# GMS endpoint. Local quickstart default is http://localhost:8080.
DATAHUB_GMS_URL=http://localhost:8080
# Personal access token from DataHub > Settings > Access Tokens.
DATAHUB_GMS_TOKEN=REPLACE_WITH_DATAHUB_PAT

# --- Anthropic --------------------------------------------------------------
# Used only by core/agent for prose explanations and candidate fix code.
# The model never sets severity and never gates a write; see README.md.
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# --- GitHub -----------------------------------------------------------------
# Needs pull-requests:write to post the review comment and contents:write to
# push the fix branch. In Actions this is the injected GITHUB_TOKEN.
GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN

# --- Optional: access-path selection ---------------------------------------
# "mcp" uses mcp-server-datahub; "sdk" uses acryl-datahub directly.
BLAST_RADIUS_DATAHUB_MODE=mcp
# Mutation tools require mcp-server-datahub v0.5.0+ started with this set to true.
TOOLS_IS_MUTATION_ENABLED=false
# Model used for prose and candidate fixes.
BLAST_RADIUS_MODEL=claude-sonnet-5
